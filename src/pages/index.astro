---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form
          method="get"
          action="/"
          class="bg-slate-800/70 border border-slate-700 rounded-xl p-4"
          data-testid="game-filters"
        >
          <fieldset>
            <legend class="text-sm font-semibold text-slate-100 mb-3">Filter games</legend>

            <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
              <div>
                <span class="block text-xs font-medium uppercase tracking-wide text-slate-400 mb-2">Categories</span>
                <div class="flex flex-wrap gap-x-4 gap-y-2">
                  {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-200">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`category-filter-${category.id}`}
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </div>

              <label class="text-sm text-slate-200">
                <span class="block text-xs font-medium uppercase tracking-wide text-slate-400 mb-2">Publisher</span>
                <select
                  name="publisher"
                  class="min-w-44 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </label>

              <button
                type="submit"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="apply-filters"
              >
                Apply
              </button>
              <a
                href="/"
                class="rounded-lg border border-slate-600 px-4 py-2 text-center text-sm font-semibold text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear
              </a>
            </div>
          </fieldset>
        </form>
      </div>

      <p class="mb-4 text-sm text-slate-400" data-testid="filter-status" role="status" aria-live="polite">
        Showing {games.length} games
      </p>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  if (form && status && emptyState && grid) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';
    const categoryInputs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) {
      publisherInput.value = selectedPublisher;
    }

    const visibleCards = cards.filter((card) => {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
      const visible = categoryMatches && publisherMatches;
      card.hidden = !visible;
      return visible;
    });

    const hasFilters = selectedCategories.size > 0 || selectedPublisher !== '';
    status.textContent = hasFilters
      ? `Showing ${visibleCards.length} of ${cards.length} games`
      : `Showing ${cards.length} games`;
    emptyState.classList.toggle('hidden', visibleCards.length > 0);
    grid.classList.toggle('hidden', visibleCards.length === 0);
  }
</script>
